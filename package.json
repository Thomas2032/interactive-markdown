{
  "name": "interactive-markdown",
  "version": "0.7.0",
  "description": "Interactive Markdown (IVM): plain .md with live SVG, XY plots, graphs, editor polish (picker sync, @ns help, copy fence / reset env), @fn macros, arrays, angle mode, phases, local assets",
  "main": "./src/index.js",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "start": "serve .",
    "test": "node test/smoke-expr.mjs && node test/smoke-parse-ivm.mjs && node test/smoke-sanitize-svg.mjs && node test/smoke-render.mjs && node test/smoke-markdown.mjs && node test/smoke-graph.mjs && node test/smoke-plot.mjs && node test/smoke-document.mjs",
    "test:expr": "node test/smoke-expr.mjs",
    "test:parse": "node test/smoke-parse-ivm.mjs",
    "test:sanitize": "node test/smoke-sanitize-svg.mjs",
    "test:render": "node test/smoke-render.mjs",
    "test:markdown": "node test/smoke-markdown.mjs",
    "test:graph": "node test/smoke-graph.mjs",
    "test:document": "node test/smoke-document.mjs",
    "test:plot": "node test/smoke-plot.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomas2032/interactive-markdown.git"
  },
  "keywords": [
    "markdown",
    "svg",
    "interactive",
    "ivm",
    "editor"
  ],
  "author": "Thomas Lo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Thomas2032/interactive-markdown/issues"
  },
  "homepage": "https://github.com/Thomas2032/interactive-markdown#readme",
  "devDependencies": {
    "linkedom": "^0.18.13",
    "serve": "^14.2.6"
  },
  "type": "module",
  "dependencies": {
    "marked": "^18.1.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./expr": "./src/expr.js",
    "./parse-ivm": "./src/parse-ivm.js",
    "./sanitize-svg": "./src/sanitize-svg.js",
    "./render": "./src/render.js",
    "./markdown": "./src/markdown.js",
    "./plot": "./src/plot.js"
  },
  "files": [
    "src",
    "examples",
    "styles",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
