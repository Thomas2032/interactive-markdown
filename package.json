{
  "name": "interactive-markdown",
  "version": "0.11.0",
  "description": "Interactive Markdown (IVM): plain .md with live SVG, XY plots, read-only @graph layout=dagre, @data tables\u2192series, remap/px/py + @anchor helpers, bar/scatter, @scrub, diagnostics + ivm check",
  "main": "./src/index.js",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "start": "serve .",
    "test": "node test/smoke-expr.mjs && node test/smoke-parse-ivm.mjs && node test/smoke-sanitize-svg.mjs && node test/smoke-render.mjs && node test/smoke-markdown.mjs && node test/smoke-graph.mjs && node test/smoke-plot.mjs && node test/smoke-document.mjs && node test/smoke-diagnostics.mjs && node test/smoke-autocomplete.mjs && node test/smoke-p2.mjs",
    "test:expr": "node test/smoke-expr.mjs",
    "test:parse": "node test/smoke-parse-ivm.mjs",
    "test:sanitize": "node test/smoke-sanitize-svg.mjs",
    "test:render": "node test/smoke-render.mjs",
    "test:markdown": "node test/smoke-markdown.mjs",
    "test:graph": "node test/smoke-graph.mjs",
    "test:document": "node test/smoke-document.mjs",
    "test:plot": "node test/smoke-plot.mjs",
    "check": "node bin/ivm-check.mjs",
    "test:diagnostics": "node test/smoke-diagnostics.mjs",
    "test:autocomplete": "node test/smoke-autocomplete.mjs",
    "test:p2": "node test/smoke-p2.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomas2032/interactive-markdown.git"
  },
  "keywords": [
    "markdown",
    "svg",
    "interactive",
    "ivm",
    "editor"
  ],
  "author": "Thomas Lo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Thomas2032/interactive-markdown/issues"
  },
  "homepage": "https://github.com/Thomas2032/interactive-markdown#readme",
  "devDependencies": {
    "linkedom": "^0.18.13",
    "serve": "^14.2.6"
  },
  "type": "module",
  "dependencies": {
    "marked": "^18.1.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./expr": "./src/expr.js",
    "./parse-ivm": "./src/parse-ivm.js",
    "./sanitize-svg": "./src/sanitize-svg.js",
    "./render": "./src/render.js",
    "./markdown": "./src/markdown.js",
    "./plot": "./src/plot.js",
    "./diagnostics": "./src/diagnostics.js",
    "./autocomplete": "./src/autocomplete.js",
    "./graph-layout": "./src/graph-layout.js"
  },
  "files": [
    "src",
    "examples",
    "styles",
    "index.html",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ivm-check": "bin/ivm-check.mjs"
  }
}
